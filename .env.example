# Backblaze B2 (S3-compatible) — required.
# The S3 endpoint is derived from the region: https://s3.{B2_REGION}.backblazeb2.com
B2_REGION=your_region
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Optional: public base URL for objects. The video player uses presigned URLs,
# so this is not required.
B2_PUBLIC_URL_BASE=

# --- Qwen2.5-VL (local, on-device) — no API key needed ---
# Device autodetect order is CUDA -> Apple MPS -> CPU. Set QWEN_DEVICE to force
# one (e.g. cpu, cuda, mps). Default model is the ungated 3B variant.
# QWEN_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
# QWEN_DEVICE=

# Example of what filled-in B2 values look like (fake — for visual reference only):
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=your-application-key-here-31-chars
# B2_BUCKET_NAME=my-video-library
