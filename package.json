{
  "name": "qwen-video-chapters",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @qwen-video-chapters/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @qwen-video-chapters/web build",
    "typecheck": "pnpm --filter @qwen-video-chapters/web typecheck",
    "lint": "pnpm --filter @qwen-video-chapters/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @qwen-video-chapters/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "1.19.17",
      "@modelcontextprotocol/sdk>ajv": "8.20.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "eslint>ajv": "6.14.0",
      "body-parser": "2.3.0",
      "brace-expansion": "5.0.9",
      "esbuild": "0.25.12",
      "express-rate-limit": "8.6.2",
      "fast-uri": "3.1.5",
      "flatted": "3.4.4",
      "hono": "4.13.2",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "minimatch": "10.2.6",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.5",
      "postcss": "8.5.26",
      "qs": "6.15.3",
      "shell-quote": "1.9.0",
      "vite": "7.3.6"
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
